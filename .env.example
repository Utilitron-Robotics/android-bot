# Robot Configuration
ROBOT_TYPE=tibo
ROBOT_IP=192.168.1.100    # Change to your robot's IP
ROBOT_PORT=9090

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Timeouts (seconds)
CONNECTION_TIMEOUT=5
NAVIGATION_TIMEOUT=300
AUDIO_PLAYBACK_TIMEOUT=120

# Reconnection Settings
MAX_RECONNECTION_ATTEMPTS=3
RECONNECTION_DELAY=2

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
ENABLE_FILE_LOGGING=true