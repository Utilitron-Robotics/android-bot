<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <LinearLayout
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- Frontier Tower Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="#0A0E14">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivFtLogo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/frontiertowerlogo"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
                app:strokeWidth="1dp"
                app:strokeColor="#FFFFFF"
                android:padding="0dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FRONTIER TOWER"
                    android:textSize="12sp"
                    android:textColor="#9333EA"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvFloorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spaceship"
                    android:textSize="10sp"
                    android:textColor="#888888"
                    android:drawableStart="@android:drawable/ic_menu_mapmode"
                    android:drawablePadding="4dp"
                    android:drawableTint="#666666" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#333333"
                android:layout_marginHorizontal="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROBOT RELAY"
                android:textSize="14sp"
                android:textColor="#00ff88"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvHeaderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="14sp"
                android:textColor="#00ff88" />

        </LinearLayout>

        <!-- Main Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Left Panel: Status -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="8dp">

            <TextView
                android:id="@+id/tvIpAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Relay: --"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333"
                android:layout_marginVertical="12dp" />

            <TextView
                android:id="@+id/tvRobotStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Robot: DISCONNECTED"
                android:textSize="16sp"
                android:textColor="#AA0000" />

            <TextView
                android:id="@+id/tvRelayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Relay: Stopped"
                android:textSize="14sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvClients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clients: 0"
                android:textSize="14sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333"
                android:layout_marginVertical="12dp" />

            <TextView
                android:id="@+id/tvBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battery: --%"
                android:textSize="14sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pos: (0, 0)"
                android:textSize="14sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvVelocity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vel: 0 m/s"
                android:textSize="14sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvNavStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nav: Idle"
                android:textSize="14sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvSensorStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sensors: OK"
                android:textSize="14sp"
                android:textColor="#00AA00"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvEstop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-STOP ACTIVE"
                android:textSize="18sp"
                android:textColor="#FF0000"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333"
                android:layout_marginVertical="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM STATUS"
                android:textSize="16sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvSpeedStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speed: Medium"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvSlamStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mode: Navigating"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF" />

                <ImageView
                    android:id="@+id/ivSlamIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_mapmode"
                    android:visibility="gone"
                    android:layout_marginStart="8dp"
                    app:tint="#00ff88" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="System Audio"
                android:textColor="#FFFFFF"
                android:checked="true"
                android:layout_marginTop="8dp"/>


            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <EditText
                android:id="@+id/etRobotIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Robot IP"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:background="#333333"
                android:padding="8dp"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnReconnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save IP &amp; Restart"
                android:backgroundTint="#336699" />

        </LinearLayout>

        <!-- Center Panel: Joystick -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:padding="16dp">

            <!-- Background logo (dimmed) -->
            <ImageView
                android:id="@+id/joystick_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/frontiertowerlogo"
                android:scaleType="centerInside"
                android:alpha="0.15"
                android:background="@drawable/joystick_background_rounded" />

            <!-- Joystick control -->
            <com.smait.robotrelay.ui.JoystickView
                android:id="@+id/joystickView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- Right Panel: Actions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAVIGATION"
                android:textSize="16sp"
                android:textColor="#888888" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etPoi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="POI name"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:background="#333333"
                    android:padding="8dp" />

                <Button
                    android:id="@+id/btnGoPoi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GO"
                    android:backgroundTint="#448844"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancel Navigation"
                android:backgroundTint="#886644"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333"
                android:layout_marginVertical="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPEED"
                android:textSize="16sp"
                android:textColor="#888888" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnSpeedSlow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Slow"
                    android:backgroundTint="#336699" />

                <Button
                    android:id="@+id/btnSpeedMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Medium"
                    android:backgroundTint="#336699"
                    android:layout_marginHorizontal="4dp" />

                <Button
                    android:id="@+id/btnSpeedFast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fast"
                    android:backgroundTint="#336699" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333"
                android:layout_marginVertical="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM"
                android:textSize="16sp"
                android:textColor="#888888" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnSlamOn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SLAM On"
                    android:backgroundTint="#006600" />

                <Button
                    android:id="@+id/btnSlamOff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SLAM Off"
                    android:backgroundTint="#AA0000"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333"
                android:layout_marginVertical="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMERGENCY"
                android:textSize="16sp"
                android:textColor="#888888" />

            <Button
                android:id="@+id/btnEstop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="E-STOP"
                android:backgroundTint="#AA0000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnReleaseEstop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Release E-Stop"
                android:backgroundTint="#006600"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        </LinearLayout> <!-- End Main Content horizontal -->

    </LinearLayout> <!-- End main_layout vertical -->

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Floating countdown timer overlay - visible above all content (large for crowds) -->
    <FrameLayout
        android:id="@+id/countdownOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/countdown_background"
        android:padding="32dp"
        android:elevation="25dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvCountdownLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next stop in"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:alpha="0.9" />

            <TextView
                android:id="@+id/tvCountdownTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="96sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

        </LinearLayout>

    </FrameLayout>

    <!-- Motion standby overlay - waiting for visitor / start tour -->
    <FrameLayout
        android:id="@+id/motionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1a1a2e"
        android:visibility="gone"
        android:elevation="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="48dp">

            <!-- Waiting for visitor state -->
            <LinearLayout
                android:id="@+id/motionWaitingLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👋"
                    android:textSize="128sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Waiting for visitor..."
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:layout_marginTop="32dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Approach to start your tour"
                    android:textColor="#888888"
                    android:textSize="24sp"
                    android:layout_marginTop="16dp" />

            </LinearLayout>

            <!-- Start tour state - shown when motion detected -->
            <LinearLayout
                android:id="@+id/motionStartLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖"
                    android:textSize="128sp" />

                <TextView
                    android:id="@+id/tvMotionGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello! Ready for a tour?"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="32dp" />

                <Button
                    android:id="@+id/btnStartTour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="300dp"
                    android:minHeight="100dp"
                    android:text="START TOUR"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:backgroundTint="#00AA00"
                    android:layout_marginTop="48dp"
                    android:padding="24dp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Tour mode lock screen overlay - transparent touch interceptor -->
    <FrameLayout
        android:id="@+id/lockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:elevation="20dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Professional START TOUR button - visible when locked, for visitors -->
        <LinearLayout
            android:id="@+id/lockStartTourLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center"
            android:background="#F5F5F5"
            android:visibility="gone"
            android:padding="32dp">

            <!-- Clean professional header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome"
                android:textSize="56sp"
                android:textColor="#1565C0"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap below to begin your experience"
                android:textSize="20sp"
                android:textColor="#616161"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="56dp" />

            <!-- Elegant start button -->
            <Button
                android:id="@+id/btnLockStartTour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="360dp"
                android:minHeight="90dp"
                android:text="START TOUR"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:backgroundTint="#1976D2"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="56dp"
                android:paddingVertical="20dp"
                android:elevation="8dp" />

            <!-- Subtle branding -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Powered by RobotOS Pro"
                android:textSize="12sp"
                android:textColor="#BDBDBD"
                android:fontFamily="sans-serif-light"
                android:layout_marginTop="80dp" />

        </LinearLayout>

        <!-- Lock content - only shown when PIN entry is triggered -->
        <LinearLayout
            android:id="@+id/lockContentLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:background="#DD000000"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="64sp" />

            <TextView
                android:id="@+id/tvLockMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tour Mode Active"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to enter unlock code"
                android:textColor="#AAAAAA"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <!-- PIN entry -->
            <LinearLayout
                android:id="@+id/pinEntryLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etPinCode"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:hint="Enter PIN"
                    android:inputType="numberPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:background="#333333"
                    android:padding="16dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/btnPinCancel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cancel"
                        android:backgroundTint="#666666" />

                    <Button
                        android:id="@+id/btnPinSubmit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unlock"
                        android:backgroundTint="#448844"
                        android:layout_marginStart="16dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
