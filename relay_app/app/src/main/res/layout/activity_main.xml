<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <LinearLayout
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Left Panel: Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROBOT RELAY"
                android:textSize="24sp"
                android:textColor="#00ff88"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIpAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Relay: --"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333"
                android:layout_marginVertical="12dp" />

            <TextView
                android:id="@+id/tvRobotStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Robot: DISCONNECTED"
                android:textSize="16sp"
                android:textColor="#AA0000" />

            <TextView
                android:id="@+id/tvRelayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Relay: Stopped"
                android:textSize="14sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvClients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clients: 0"
                android:textSize="14sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333"
                android:layout_marginVertical="12dp" />

            <TextView
                android:id="@+id/tvBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battery: --%"
                android:textSize="14sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pos: (0, 0)"
                android:textSize="14sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvVelocity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vel: 0 m/s"
                android:textSize="14sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvNavStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nav: Idle"
                android:textSize="14sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvSensorStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sensors: OK"
                android:textSize="14sp"
                android:textColor="#00AA00"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvEstop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-STOP ACTIVE"
                android:textSize="18sp"
                android:textColor="#FF0000"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333"
                android:layout_marginVertical="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM STATUS"
                android:textSize="16sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvSpeedStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speed: Medium"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvSlamStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mode: Navigating"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF" />

                <ImageView
                    android:id="@+id/ivSlamIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_mapmode"
                    android:visibility="gone"
                    android:layout_marginStart="8dp"
                    app:tint="#00ff88" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="System Audio"
                android:textColor="#FFFFFF"
                android:checked="true"
                android:layout_marginTop="8dp"/>


            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <EditText
                android:id="@+id/etRobotIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Robot IP"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:background="#333333"
                android:padding="8dp"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnReconnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save IP &amp; Restart"
                android:backgroundTint="#336699" />

        </LinearLayout>

        <!-- Center Panel: D-Pad -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <!-- Top row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnForwardLeft"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:text="↖"
                    android:textSize="24sp"
                    android:backgroundTint="#445566" />

                <Button
                    android:id="@+id/btnForward"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:text="↑"
                    android:textSize="24sp"
                    android:backgroundTint="#446688"
                    android:layout_marginHorizontal="4dp" />

                <Button
                    android:id="@+id/btnForwardRight"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:text="↗"
                    android:textSize="24sp"
                    android:backgroundTint="#445566" />
            </LinearLayout>

            <!-- Middle row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginVertical="4dp">

                <Button
                    android:id="@+id/btnLeft"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:text="↺"
                    android:textSize="24sp"
                    android:backgroundTint="#446688" />

                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:text="■"
                    android:textSize="24sp"
                    android:backgroundTint="#884444"
                    android:layout_marginHorizontal="4dp" />

                <Button
                    android:id="@+id/btnRight"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:text="↻"
                    android:textSize="24sp"
                    android:backgroundTint="#446688" />
            </LinearLayout>

            <!-- Bottom row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="70dp"
                    android:layout_height="70dp" />

                <Button
                    android:id="@+id/btnBackward"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:text="↓"
                    android:textSize="24sp"
                    android:backgroundTint="#446688"
                    android:layout_marginHorizontal="4dp" />

                <View
                    android:layout_width="70dp"
                    android:layout_height="70dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Right Panel: Actions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAVIGATION"
                android:textSize="16sp"
                android:textColor="#888888" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etPoi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="POI name"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:background="#333333"
                    android:padding="8dp" />

                <Button
                    android:id="@+id/btnGoPoi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GO"
                    android:backgroundTint="#448844"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancel Navigation"
                android:backgroundTint="#886644"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333"
                android:layout_marginVertical="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPEED"
                android:textSize="16sp"
                android:textColor="#888888" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnSpeedSlow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Slow"
                    android:backgroundTint="#336699" />

                <Button
                    android:id="@+id/btnSpeedMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Medium"
                    android:backgroundTint="#336699"
                    android:layout_marginHorizontal="4dp" />

                <Button
                    android:id="@+id/btnSpeedFast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fast"
                    android:backgroundTint="#336699" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333"
                android:layout_marginVertical="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM"
                android:textSize="16sp"
                android:textColor="#888888" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnSlamOn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SLAM On"
                    android:backgroundTint="#006600" />

                <Button
                    android:id="@+id/btnSlamOff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SLAM Off"
                    android:backgroundTint="#AA0000"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333"
                android:layout_marginVertical="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMERGENCY"
                android:textSize="16sp"
                android:textColor="#888888" />

            <Button
                android:id="@+id/btnEstop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="E-STOP"
                android:backgroundTint="#AA0000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnReleaseEstop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Release E-Stop"
                android:backgroundTint="#006600"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
